{
  // ⚠️ STAGING ONLY — 이 파일은 develop 브랜치 전용입니다.
  // main으로 승격(patch/cherry-pick)할 때 이 파일은 절대 포함하지 마세요.
  // database_id/id가 스테이징 DB/KV를 직접 가리키도록 되어 있습니다 (운영과 다름).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lookbook-ai",
  "compatibility_date": "2026-07-10",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "LOOKBOOK_DB",
      "database_name": "lookbook-ai-staging",
      "database_id": "be2a980f-aa0d-4631-9a87-717281028129"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LOOKBOOK_KV",
      "id": "6a5dcf373bfb43aea55c958a2b7e7886"
    }
  ]
}
