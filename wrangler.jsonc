{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lookbook-ai",
  "compatibility_date": "2026-07-10",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "LOOKBOOK_KV",
      "id": "PLACEHOLDER_KV_ID",
      "preview_id": "PLACEHOLDER_KV_PREVIEW_ID"
    }
  ]
}
